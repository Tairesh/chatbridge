INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_VERIFY_TOKEN=your_instagram_verify_token
DATABASE_URL=postgres://chatbridge:chatbridge@postgres:5432/chatbridge
REDIS_URL=redis://redis:6379
APP_JWT_SECRET=your-jwt-secret-here-at-least-32-bytes
PUBLIC_BASE_URL=https://example.com
# Optional. Log level, e.g. `chatbridge=debug` to see raw webhook payloads and every
# provider call. Defaults to `info`.
# RUST_LOG=chatbridge=debug
# Optional. Overrides all three Meta hosts at once (authorize, api, graph).
# Point it at a fake Instagram API for local work.
# INSTAGRAM_API_BASE=http://localhost:8082
# Optional. Defaults to https://api.telegram.org. Point it at a mock Bot API for local work.
# TELEGRAM_API_BASE=http://localhost:8081
